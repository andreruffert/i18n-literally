{
  "name": "i18n-literally",
  "version": "1.7.1",
  "description": "A simple way to introduce internationalization to your JS",
  "license": "MIT",
  "repository": "andreruffert/i18n-literally",
  "author": "André Ruffert",
  "type": "module",
  "main": "index.js",
  "bin": {
    "literally": "cli/cli.js"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "files": [
    "index.js",
    "cli"
  ],
  "scripts": {
    "test": "node --test \"./test/*.js\"",
    "test-translations": "./cli/cli.js check-missing-translations test/index.spec.js",
    "literally": "./cli/cli.js test/index.spec.js"
  },
  "keywords": [
    "i18n",
    "js",
    "template-literals",
    "internationalization",
    "translation",
    "localization",
    "cli"
  ],
  "dependencies": {
    "@babel/parser": "7.27.0",
    "chalk": "5.4.1",
    "meow": "13.2.0",
    "open": "10.1.1"
  }
}
